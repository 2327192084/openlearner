node_modules/
dist/
release/
.npm-cache/
.pnpm-store/
*.log
.DS_Store
.vite/
coverage/

# 验收脚本产物（截图与临时浏览器 profile，不入库）
.verify-shots/
*.tsbuildinfo

# 调试与构建临时目录
.scratch/
.scratch-t/
.scratch-test-native.cjs
.tmp/

# 图文页渲染验证产物
.verify-figure/
.m.txt

# esbuild 构建临时目录（Access is denied 时用它绕开）
.tmp-esbuild/

# v1 资料备份（89MB 二进制，不入库；需要时从桌面程序目录恢复）
.backup-v1/

# StudyHub 参考仓库（67MB，子代理 clone 用于对照设计系统）
# 需要时重新 clone：git clone --depth 1 https://github.com/EricWang1358/dsh-web-studyhub
.tmp/

# Python 缓存（_patch.py 生成的）
__pycache__/
*.pyc

# StudyHub 会话数据（StudyHub 自己的工具管，不进代码库）
.dsh-study/

# 安装包产物（2026-11-11）
# GitHub 单文件上限 100MB，101MB 的安装包会被 pre-receive hook 拒绝。
# 安装包不进 git，改由 Release 附件分发。
build/*.exe
build/*.zip
build/*.7z
OpenLeaner-*-setup.exe

# IndexedDB 残留（诊断脚本若在仓库根跑会建出 blobs/ 与 db/）
/blobs/
/db/

# Chromium 临时 profile（诊断脚本若把 --user-data-dir 跑空会在仓库根建出这些）
/Code Cache/
/GPUCache/
/DawnGraphiteCache/
/DawnWebGPUCache/
/Shared Dictionary/
/Session Storage/
/blob_storage/
/WebStorage/
/Local Storage/
/Network/
/Cache/
/DIPS
/DIPS-wal
/DevToolsActivePort
/Local State
/Preferences
/SharedStorage
/SharedStorage-wal
